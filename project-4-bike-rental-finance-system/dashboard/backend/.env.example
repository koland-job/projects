# Copy to .env and fill in real values. The .env file itself is never committed.
# DATA_SOURCE=demo reads demo/snapshot.json instead of Google (nothing below is needed then).
DATA_SOURCE=sheets
SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
CREDENTIALS_DIR=../credentials
CACHE_TTL_SECONDS=300
TIMEZONE=Etc/GMT-7

# Optional: look tabs up by numeric id instead of title, e.g. SHEET_IDS={"P&L": 0}
SHEET_IDS=

# Server only — without them, only requests from 127.0.0.1 are let in locally
DASHBOARD_USER=
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SECRET=

# "Recalculate reports" menu item in Google Sheets (Apps Script). Empty — the item is disabled.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RECALC_TOKEN=
